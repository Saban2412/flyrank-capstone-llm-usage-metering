# Server Configuration
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# PostgreSQL Database (Host port 5436 maps to container port 5432 in docker-compose.yml)
DB_HOST=localhost
DB_PORT=5436
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=metering_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/metering_db

# Stripe Test Mode / Sandbox Secrets 
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PRO_PRICE_ID=price_your_pro_plan_price_id_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here